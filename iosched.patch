From eebc312a63d2dd42faa3902c15c85f19696e39cf Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Tue, 25 Mar 2025 15:21:17 -0300
Subject: [PATCH] block: elevator: check task_is_booster() instead of comparing
 in place

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
Signed-off-by: Yahya Wessam <yahyawessam2002@gmail.com>
---
 block/elevator.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/block/elevator.c b/block/elevator.c
index 558d44004a36..6a09e7cab943 100644
--- a/block/elevator.c
+++ b/block/elevator.c
@@ -36,6 +36,7 @@
 #include <linux/uaccess.h>
 #include <linux/pm_runtime.h>
 #include <linux/blk-cgroup.h>
+#include <linux/binfmts.h>
 
 #include <trace/events/block.h>
 
@@ -90,6 +91,11 @@ static struct elevator_type *elevator_find(const char *name, bool mq)
 {
 	struct elevator_type *e;
 
+	/* Forbid init from changing I/O scheduler from default */
+	if (task_is_booster(current))
+		return NULL;
+
+
 	list_for_each_entry(e, &elv_list, list) {
 		if (!strcmp(e->elevator_name, name) && (mq == e->uses_mq))
 			return e;

